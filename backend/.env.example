# Copy to .env (never commit .env) and fill in.

# Secret used to sign login tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# If unset, a random one is used and everyone is signed out on every restart.
JWT_SECRET=

# How long a login lasts (e.g. 30m, 8h, 7d)
JWT_TTL=8h

# Port for the API
PORT=4000

# Comma-separated origins allowed to call the API (default: any). In production
# set this to your frontend's URL, e.g. https://meditrack.example.com
CORS_ORIGIN=

# Password given to the demo accounts created by `npm run seed` / `npm run seed:users`
DEMO_PASSWORD=Meditrack@123
